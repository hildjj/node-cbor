{
  "include": ["lib/*.js", "vendor/**/*.js"],

  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "strict": false,
    "module": "commonjs",
    "outDir": "types",
    "target": "ES2020",
    "rootDir": ".",
    "types": ["node"],
  }
}
